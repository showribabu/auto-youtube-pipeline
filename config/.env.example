# Auto YouTube Pipeline - Configuration
# Edit this file and rename to .env when ready

# --- YouTube / Google API ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# --- Edge TTS Voices (free, no key needed) ---
# Default voices per language
DEFAULT_VOICE_MALE=en-US-GuyNeural
DEFAULT_VOICE_FEMALE=en-US-SaraNeural
KIDS_VOICE_MALE=en-US-JackNeural
KIDS_VOICE_FEMALE=en-US-JennyNeural

# --- FFmpeg Path ---
FFMPEG_PATH=C:/Users/kanta/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.1-full_build/bin/ffmpeg.exe
FFPROBE_PATH=C:/Users/kanta/AppData/Local/Microsoft/WinGet/Packages/Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe/ffmpeg-9.1-full_build/bin/ffprobe.exe

# --- Output Settings ---
OUTPUT_RESOLUTION=1280x720
OUTPUT_FPS=30
OUTPUT_FORMAT=mp4
DEFAULT_VIDEO_DURATION=60
MAX_VIDEOS_PER_DAY=3

# --- Scheduling (cron format, UTC) ---
# Daily upload times
SCHEDULE_KIDS=0 8 * * *
SCHEDULE_NEWS=0 7 * * *
SCHEDULE_WEATHER=0 6 * * *
SCHEDULE_FACTS=0 12 * * *
SCHEDULE_MOTIVATIONAL=0 18 * * *

# --- Retry Settings ---
MAX_RETRIES=3
RETRY_DELAY_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=D:/PROJECT/Coding/auto-youtube-pipeline/logs/pipeline.log
